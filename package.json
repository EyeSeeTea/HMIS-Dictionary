{
    "name": "hmis-dictionary",
    "description": "DHIS2 HMIS Dictionary app",
    "version": "1.16.1",
    "license": "GPL-3.0",
    "author": "MSF OCBA, EyeSeeTea team",
    "homepage": ".",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/EyeSeeTea/HMIS-Dictionary.git"
    },
    "packageManager": "yarn@4.18.1",
    "dependencies": {
        "$": "link:./src",
        "@dhis2/app-runtime": "^3",
        "@dhis2/d2-i18n": "^1",
        "@dhis2/data-engine": "3.17.0",
        "@dhis2/ui": "^10",
        "@eyeseetea/d2-ui-components": "^2",
        "@eyeseetea/feedback-component": "^0",
        "@material-ui/core": "^4",
        "@material-ui/icons": "^4",
        "@material-ui/styles": "^4",
        "@tinymce/tinymce-react": "^6.3.1",
        "buffer": "^6.0.3",
        "d2-api-40": "npm:@eyeseetea/d2-api@40.11.0-beta.1",
        "d2-api-42": "npm:@eyeseetea/d2-api@42.22.0-beta.3",
        "d2-manifest": "^1",
        "dompurify": "^3.4.17",
        "purify-ts": "^1",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-router-dom": "5.3.4",
        "real-cancellable-promise": ">=1",
        "styled-jsx": "^5",
        "tinymce": "^8.10.1",
        "typed-immutable-map": ">=0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@johanblumenberg/ts-mockito": "^1.0.52",
        "@playwright/test": "1.60",
        "@prettier/sync": "^0.6.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^14.0.0",
        "@types/gettext-parser": "^9",
        "@types/material-ui": "^0.21.12",
        "@types/node": "^20",
        "@types/react": "18.2.22",
        "@types/react-dom": "18.2.7",
        "@types/react-router-dom": "5.3.3",
        "@typescript-eslint/eslint-plugin": "^8",
        "@typescript-eslint/parser": "^8",
        "@typescript-eslint/utils": "^8.65.0",
        "@vitejs/plugin-react": "^5.0.4",
        "eslint": "^9.39.5",
        "eslint-plugin-no-relative-import-paths": "^1.5.3",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-testing-library": "^7.16.2",
        "eslint-plugin-unused-imports": "^4",
        "exceljs": "^4.4.0",
        "expect-type": "^0",
        "gettext-parser": "^9",
        "husky": "^7",
        "jsdom": "^21",
        "knip": "^6.44.1",
        "prettier": "^3.8.1",
        "source-map-explorer": "^2",
        "tsx": "^4.19.3",
        "typedoc": "^0",
        "typescript": "5.7.3",
        "typescript-eslint": "^8",
        "vite": "^7.3.6",
        "vite-bundle-visualizer": "^0",
        "vite-plugin-checker": "^0.14.5",
        "vitest": "^4.1.12"
    },
    "resolutions": {
        "@types/react": "18.2.22",
        "@types/react-dom": "18.2.7",
        "axios": "^1.18.0",
        "exceljs/uuid": "^11.1.1",
        "i18next": "19.8.5",
        "lodash": "^4.18.0",
        "minimatch@npm:^10.2.2": "^11.0.1",
        "minimatch@npm:^10.2.5": "^11.0.1",
        "moment": "^2.31.0",
        "node-fetch": "^2.6.7",
        "qs": "^6.16.1",
        "react-linkify/linkify-it": "^5.0.2"
    },
    "scripts": {
        "build": "yarn localize && VITE_DHIS2_BASE_URL='' VITE_DHIS2_AUTH='' yarn build-folder && rm -f $npm_package_name.zip && cd build && zip --quiet -r ../$npm_package_name.zip *",
        "build-dependencies-visualizer": "vite-bundle-visualizer",
        "build-folder": "rm -rf build/ && d2-manifest package.json manifest.webapp && tsc && vite build --outDir=build && yarn run manifest && cp -r i18n icon.png build",
        "check": "yarn typecheck && yarn prettify:check && yarn lint && yarn test",
        "extract-pot": "yarn run-script src/scripts/dev/ExtractPotScript.ts",
        "generate-docs": "typedoc --entryPointStrategy expand ./src",
        "lint": "eslint src",
        "lint-all": "yarn lint && yarn lint-unused",
        "lint-unused": "knip",
        "localize": "yarn update-po && yarn run-script src/scripts/dev/GenerateLocalesScript.ts",
        "manifest": "d2-manifest package.json build/manifest.webapp",
        "postinstall": "yarn localize || echo '⚠ localize failed — run `yarn localize` before building'",
        "prepare": "corepack enable 2>/dev/null || true && husky install",
        "prettify": "prettier \"./**/*.{js,jsx,json,css,ts,tsx}\" --write",
        "prettify:check": "prettier \"./**/*.{js,jsx,json,css,ts,tsx}\" --check",
        "run-script": "tsx",
        "source-map-explorer": "yarn build --sourcemap=true && source-map-explorer --no-border-checks --only-mapped build/assets/*js",
        "start": "vite --strictPort",
        "test": "yarn test:unit",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest watch",
        "test:e2e": "playwright test -c e2e/playwright.config.ts",
        "test:e2e:read": "playwright test -c e2e/playwright.config.ts --project=read",
        "test:e2e:smoke": "playwright test -c e2e/playwright.config.ts --project=read --grep @smoke",
        "typecheck": "tsc --noEmit",
        "update-po": "yarn extract-pot && yarn run-script src/scripts/dev/UpdatePoScript.ts"
    },
    "manifest.webapp": {
        "name": "HMIS Dictionary",
        "description": "HMIS Dictionary App",
        "icons": {
            "48": "icon.png"
        },
        "developer": {
            "url": "https://www.eyeseetea.com/",
            "name": "MSF OCBA, EyeSeeTea team"
        },
        "activities": {
            "dhis": {
                "href": "*"
            }
        }
    }
}
